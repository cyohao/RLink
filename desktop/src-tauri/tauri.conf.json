{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "瑞联",
  "mainBinaryName": "ruilink",
  "version": "1.0.1",
  "identifier": "com.huarui.ruilink",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "华瑞",
    "shortDescription": "瑞联",
    "longDescription": "接口模拟、接口调用和联调日志工具，可以离线使用，也可以连接服务器共享数据。",
    "copyright": "华瑞",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
